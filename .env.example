# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real credentials.

# --- Ego4D dataset credentials -----------------------------------------
# Issued by email ~48hrs after your license agreement at ego4d.dev/request/ego4d
# is approved. IMPORTANT: these expire in 14 days. The intent is you
# download your subset promptly, not stream from Ego4D's S3 long-term.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Nectar object storage (Swift) --------------------------------------
# Create via Nectar Dashboard -> Identity -> Application Credentials.
# Scope it to this project only. These do NOT expire like the Ego4D ones,
# but you can revoke/rotate them independently, which is why we use an
# Application Credential rather than your personal AAF login here.
SWIFT_AUTH_URL=https://identity.rc.nectar.org.au/v3/
SWIFT_APPLICATION_CREDENTIAL_ID=
SWIFT_APPLICATION_CREDENTIAL_SECRET=

# --- Postgres (prototyping instance, see docker-compose.yml) -----------
POSTGRES_USER=egocentrism
POSTGRES_PASSWORD=changeme
POSTGRES_DB=egocentrism
